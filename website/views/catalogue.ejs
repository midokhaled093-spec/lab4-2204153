<%- include('partials/header') %>
<h1>Catalogue</h1>
<p class="count"><%= books.length %> books</p>
<div class="scroll"><table>
  <thead><tr><th>ID</th><th>Title</th><th>Author</th><th>Publisher</th><th>Category</th><th>Year</th><th class="num">Price</th></tr></thead>
  <tbody>
    <% books.forEach(b => { %>
      <tr>
        <td><%= b.book_id %></td><td><%= b.title %></td><td><%= b.author %></td>
        <td><%= b.publisher %></td><td><%= b.category %></td><td><%= b.publish_year %></td>
        <td class="num"><%= b.price.toFixed(2) %></td>
      </tr>
    <% }) %>
  </tbody>
</table></div>
<%- include('partials/footer') %>
